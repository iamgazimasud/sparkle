// Sparkle database schema
// Local dev uses SQLite. For production (Vercel), switch `provider` to
// "postgresql" and set DATABASE_URL to a Neon/Vercel Postgres URL — see DEPLOY.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String   @unique
  age       Int
  avatar    String
  pinHash   String
  sparks    Int      @default(0)
  createdAt DateTime @default(now())

  // Parent/guardian email — used for billing receipts & account recovery.
  email            String? @unique
  // Subscription: "free" | "pro". Set by the Stripe webhook.
  plan             String  @default("free")
  stripeCustomerId String? @unique

  projects Project[]
  comments Comment[]
  likes    Like[]
}

model Project {
  id        String   @id @default(cuid())
  type      String // art | youtube | code | video | music
  title     String
  desc      String
  cover     String // emoji cover
  link      String? // youtube / video url
  image     String? // uploaded image (data URL, compressed)
  createdAt DateTime @default(now())

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  comments Comment[]
  likes    Like[]

  @@index([type])
  @@index([createdAt])
}

model Comment {
  id        String   @id @default(cuid())
  text      String
  createdAt DateTime @default(now())

  authorId  String
  author    User    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Like {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([projectId])
}
