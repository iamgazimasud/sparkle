// Sparkle database schema
// Local dev uses SQLite. For production (Vercel), switch `provider` to
// "postgresql" and set DATABASE_URL to a Neon/Vercel Postgres URL — see DEPLOY.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String   @unique
  age       Int
  avatar    String
  sparks    Int      @default(0)
  createdAt DateTime @default(now())

  // Clerk handles login/passwords. clerkId links this profile to a Clerk account.
  // It's nullable so demo/seed users (content authors who never log in) can exist.
  clerkId String? @unique
  // Legacy PIN auth (kept optional for old rows; no longer used).
  pinHash String?

  // Email — used for billing receipts & notifications.
  email            String? @unique
  // Subscription: "free" | "pro". Set by the Stripe webhook.
  plan             String  @default("free")
  stripeCustomerId String? @unique

  // Safety & moderation
  isBanned   Boolean   @default(false) // banned by a moderator
  parentEmail String?  // guardian email captured at consent
  consentAt  DateTime? // parental consent timestamp (COPPA). Null = not yet consented.

  projects      Project[]
  comments      Comment[]
  likes         Like[]
  shares        Share[]
  reportsMade   Report[]  @relation("reporter")
  blocksMade    Block[]   @relation("blocker")
  blocksAgainst Block[]   @relation("blocked")
}

model Project {
  id        String   @id @default(cuid())
  type      String // art | youtube | code | video | music
  title     String
  desc      String
  cover     String // emoji cover
  link      String? // youtube / video url
  image     String? // uploaded image (data URL, compressed)
  hidden    Boolean  @default(false) // hidden by a moderator
  createdAt DateTime @default(now())

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  comments Comment[]
  likes    Like[]
  shares   Share[]
  reports  Report[]

  @@index([type])
  @@index([createdAt])
}

model Comment {
  id        String   @id @default(cuid())
  text      String
  hidden    Boolean  @default(false) // hidden by a moderator
  createdAt DateTime @default(now())

  authorId  String
  author    User    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reports   Report[]

  @@index([projectId])
}

// A safety report filed by a kid against a project, comment, or user.
model Report {
  id         String   @id @default(cuid())
  reason     String // why it was reported
  status     String   @default("open") // open | resolved | dismissed
  createdAt  DateTime @default(now())

  reporterId String
  reporter   User   @relation("reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  // What was reported (one of these is set)
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  commentId  String?
  comment    Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  targetUserId String? // reporting a user directly

  @@index([status])
}

// A re-share of a project to the sharer's feed (like a Facebook share).
model Share {
  id        String   @id @default(cuid())
  message   String? // optional note added when sharing
  createdAt DateTime @default(now())

  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([createdAt])
}

// One kid blocking another — hides the blocked user's content from the blocker.
model Block {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  blockerId String
  blocker   User   @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User   @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
}

model Like {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([projectId])
}
