# ============ REQUIRED ============

# Database. Local dev = SQLite. Production = Postgres (Neon/Vercel/Supabase).
#   Local:      "file:./dev.db"
#   Production: "postgresql://USER:PASS@HOST/DB?sslmode=require"
DATABASE_URL="file:./dev.db"

# Your live site URL (used for Stripe redirect links). On Vercel this is auto-detected,
# but set it for custom domains, e.g. "https://sparkle.com"
NEXT_PUBLIC_APP_URL="http://localhost:4321"

# Auth — Clerk. Get both keys at https://dashboard.clerk.com (create an app first).
# The app boots without these but shows a "finish setup" screen until they're set.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""


# ============ OPTIONAL: PAYMENTS (Stripe) ============
# Without these, the "Go Pro" button just says "coming soon".
# Get keys at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=""
# Create a recurring Product/Price in Stripe, paste its price id (starts with price_...)
STRIPE_PRICE_ID=""
# From Stripe -> Developers -> Webhooks -> your endpoint signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=""


# ============ OPTIONAL: EMAIL (Resend) ============
# Without these, welcome emails are skipped (app still works).
# Get a key at https://resend.com
RESEND_API_KEY=""
# A verified sender. Use Resend's test sender to start: "Sparkle <onboarding@resend.dev>"
EMAIL_FROM="Sparkle <onboarding@resend.dev>"
